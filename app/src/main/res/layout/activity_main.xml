<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <!-- App Branding Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎮 RadPad"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Gamepad IME &amp; Radial HUD powered by Zig native engine"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Live Controller Telemetry Card -->
        <LinearLayout
            android:id="@+id/banner_controller_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <TextView
                android:id="@+id/tv_controller_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍 Checking for Game Controller..."
                android:textColor="@color/status_checking"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_controller_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Aim Right Stick. Press R1 to Select. L1 returns to Base. Hold R2 for 2nd tier."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_live_input"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Stick X: 0.00 | Y: 0.00 | Triggers: None"
                android:textColor="@color/status_connected"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Live Interactive Radial Dial Preview -->
        <com.radpad.app.KinematicRadialHUDView
            android:id="@+id/main_radial_hud_view"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="@dimen/spacing_md" />

        <!-- Setup Wizard Quick Actions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ QUICK SETUP"
            android:textColor="@color/accent_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Step 1 Button -->
        <Button
            android:id="@+id/btn_enable_ime"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="@color/button_step1"
            android:text="Step 1: Enable in Android Settings"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Step 2 Button: Enable Mouse Clicks (Accessibility) -->
        <Button
            android:id="@+id/btn_enable_accessibility"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="@color/button_step2"
            android:text="@string/btn_clicks_enable"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Step 3 Button: Choose as Active Keyboard -->
        <Button
            android:id="@+id/btn_select_ime"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="@color/button_step3"
            android:text="Step 3: Choose as Active Keyboard"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Launch Always-On Floating Overlay Button -->
        <Button
            android:id="@+id/btn_floating_hud"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="@color/button_launch"
            android:text="📌 Launch Always-On Floating HUD"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Virtual Mouse Layer Card -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="MOUSE LAYER CONTROLS (HOLD R2)"
            android:textColor="@color/accent_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hold R2 to steer cursor with Right Stick. Cross / D-Pad Left = Left Click, Circle / D-Pad Right = Right Click, R3 = Middle Click, D-Pad Up/Down = Scroll Up/Down."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_accessibility_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="System Clicks: Checking..."
                android:textColor="@color/accent_danger"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Test Input Box -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="TEST TYPING AREA"
            android:textColor="@color/accent_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_test_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_field"
            android:hint="Tap here to test typing with RadPad..."
            android:minHeight="54dp"
            android:padding="@dimen/spacing_md"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp" />

        <!-- Settings Card -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="RADIAL &amp; SYSTEM SETTINGS"
            android:textColor="@color/accent_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <!-- Symmetry Setting Switch -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Equal 45° Slices (Symmetric)"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_symmetric_slices"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="@color/accent_primary"
                    android:trackTint="@color/border_primary"
                    android:checked="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_symmetry_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="ON: All 8 directions have equal 45° sectors. OFF: Wide 60° cardinals and 30° diagonals."
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="@color/border_subtle" />

            <!-- Theme Selector -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Color Scheme Theme"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spn_color_scheme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/accent_primary"
                    android:popupBackground="@color/surface_card" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Tokyo Night, Gruvbox, Dracula, or OLED Monochrome."
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="@color/border_subtle" />

            <!-- Select / Share Action -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Select / Share Button"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spn_select_action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/accent_primary"
                    android:popupBackground="@color/surface_card" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Toggle HUD (Default), Hide Keyboard, or Toggle HUD + Hide Keyboard."
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="@color/border_subtle" />

            <!-- Start / Options Action -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Start / Options Button"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spn_start_action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/accent_primary"
                    android:popupBackground="@color/surface_card" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Escape (Default), Hide Keyboard, Toggle HUD, or Toggle HUD + Hide Keyboard."
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Macro Layer Settings Card -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="⚡ MACRO LAYER CONFIGURATION (8 SLOTS)"
            android:textColor="@color/accent_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Assign built-in shortcuts or custom key/text macros to the 8 compass directions:"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Slot 0: North -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="3dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="↑ Slot 1: North (0°)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
                <Spinner
                    android:id="@+id/spn_macro_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/accent_primary"
                    android:popupBackground="@color/surface_card" />
                <Button
                    android:id="@+id/btn_macro_custom_0"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="@color/surface_elevated"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="Edit"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_info"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Slot 1: NorthEast -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="3dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="↗ Slot 2: NorthEast (45°)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
                <Spinner
                    android:id="@+id/spn_macro_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/accent_primary"
                    android:popupBackground="@color/surface_card" />
                <Button
                    android:id="@+id/btn_macro_custom_1"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="@color/surface_elevated"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="Edit"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_info"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Slot 2: East -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="3dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="→ Slot 3: East (90°)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
                <Spinner
                    android:id="@+id/spn_macro_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/accent_primary"
                    android:popupBackground="@color/surface_card" />
                <Button
                    android:id="@+id/btn_macro_custom_2"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="@color/surface_elevated"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="Edit"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_info"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Slot 3: SouthEast -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="3dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="↘ Slot 4: SouthEast (135°)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
                <Spinner
                    android:id="@+id/spn_macro_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/accent_primary"
                    android:popupBackground="@color/surface_card" />
                <Button
                    android:id="@+id/btn_macro_custom_3"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="@color/surface_elevated"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="Edit"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_info"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Slot 4: South -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="3dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="↓ Slot 5: South (180°)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
                <Spinner
                    android:id="@+id/spn_macro_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/accent_primary"
                    android:popupBackground="@color/surface_card" />
                <Button
                    android:id="@+id/btn_macro_custom_4"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="@color/surface_elevated"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="Edit"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_info"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Slot 5: SouthWest -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="3dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="↙ Slot 6: SouthWest (225°)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
                <Spinner
                    android:id="@+id/spn_macro_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/accent_primary"
                    android:popupBackground="@color/surface_card" />
                <Button
                    android:id="@+id/btn_macro_custom_5"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="@color/surface_elevated"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="Edit"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_info"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Slot 6: West -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="3dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="← Slot 7: West (270°)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
                <Spinner
                    android:id="@+id/spn_macro_6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/accent_primary"
                    android:popupBackground="@color/surface_card" />
                <Button
                    android:id="@+id/btn_macro_custom_6"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="@color/surface_elevated"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="Edit"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_info"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Slot 7: NorthWest -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="3dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="↖ Slot 8: NorthWest (315°)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
                <Spinner
                    android:id="@+id/spn_macro_7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/accent_primary"
                    android:popupBackground="@color/surface_card" />
                <Button
                    android:id="@+id/btn_macro_custom_7"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="@color/surface_elevated"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="Edit"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_info"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Collapsible Controller Button Mapping Accordion Header -->
        <LinearLayout
            android:id="@+id/btn_toggle_button_map"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:background="@drawable/bg_card_surface"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="@dimen/spacing_md">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🎮 Controller Button Mapping Reference"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/icon_chevron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼"
                android:textColor="@color/accent_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Collapsible Controller Button Mapping Content -->
        <LinearLayout
            android:id="@+id/container_button_map"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md"
            android:visibility="gone">

            <!-- Face Buttons -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FACE BUTTONS"
                android:textColor="@color/accent_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="• ▢ (Square): Backspace (Hold L2 / Shift for Real Forward Delete!)\n• ✕ (Cross): Space (Primary Action Button, supports Win/Ctrl/Alt+Space)\n• △ (Triangle): Enter / Newline (supports Win/Ctrl/Alt+Enter)\n• ○ (Circle): Tab (Indent / Field navigation, supports Win/Alt/Ctrl+Tab)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Bumpers & Triggers -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="BUMPERS &amp; TRIGGERS"
                android:textColor="@color/accent_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="• R1: Select / Commit (Right Bumper: Enter layer on Base, or type character inside layer)\n• Center R1: Toggle 2nd Page (Center stick inside Q-Z, SYM, NUM, FN and press R1 to toggle 2nd page!)\n• L1: Return to Base (Left Bumper: Instantly exits any sublayer back to Base)\n• R2: Hold for 2nd Tier (Right Trigger: Also switches to 2nd page while held)\n• L2: Shift (Left Trigger: HOLD for uppercase letters / secondary symbols)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Left Stick Modifier Joystick -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="LEFT STICK (MODIFIER JOYSTICK)"
                android:textColor="@color/accent_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="• Tilt Right: SUPER / WIN (Hold for Win+D, Win+E, Win+R, Win+Tab, Win+Arrows)\n• Tilt Down: CTRL (Hold for Ctrl+C, Ctrl+V, Ctrl+Z, Ctrl+A...)\n• Tilt Left: ALT (Hold for Alt+key, Alt+Tab, Alt+F4...)\n• Tilt Up: SHIFT (or Left Trigger L2)\n• Diagonals: Down-Right = Win+Ctrl, Up-Right = Win+Shift, Down-Left = Ctrl+Alt\n• Flick Right &amp; Release: Tap standalone Super (Windows) Key to open Start/Launcher!\n• L3 Click: Caps Lock Toggle (Lights up [CAPS])"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- D-Pad -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="D-PAD &amp; CURSOR NAVIGATION"
                android:textColor="@color/accent_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="• ← (Left): Move cursor left (Super+Left to Snap left)\n• → (Right): Move cursor right (Super+Right to Snap right)\n• ↑ (Up): Move cursor up\n• ↓ (Down): Move cursor down"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Right Stick & System -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="RIGHT STICK &amp; SYSTEM BUTTONS"
                android:textColor="@color/accent_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="• Right Stick: Aim radial sectors (or move mouse cursor when holding R2)\n• Hold R2: Mouse Layer (Right Stick = Move Cursor, D-Pad Left = Left Click, D-Pad Right = Right Click, R3 = Middle Click, D-Pad Up/Down = Scroll Up/Down)\n• Guide / Mode (Xbox/PS): Super / Windows Key (Win)\n• Start: Escape (ESC)\n• Share / Select: Toggle HUD + Hide Keyboard (Default, configurable in Settings)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

    </LinearLayout>
</ScrollView>
